{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "WebWorker"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "strict": true,
    "allowImportingTsExtensions": true
  }
}
